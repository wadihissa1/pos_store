# =============================================================
# PRODUCTION .env for the STORE (looplb.shop on Hostinger)
# Path on server: domains/looplb.shop/laravel/.env
# Copy this to `.env` on the server and fill the DB_* values.
# =============================================================

APP_NAME="Loop lb"
APP_ENV=production
APP_KEY=base64:QGo08yGnfxalNogkb5zMNXfZQdx1oFT3ujgLc9y3aMM=
APP_DEBUG=false
APP_URL=https://looplb.shop

# Images live in the LOOP POS storage and are served from the Loop POS subdomain.
# The Loop POS (looplb.systempos.lt) must have run `php artisan storage:link`.
POS_ASSET_URL=https://looplb.systempos.lt/storage

# Show stock info in the storefront (In/Out of Stock tags, "N available").
# Set to false to hide stock and allow adding to cart regardless of stock.
SHOW_STOCK=false

WHATSAPP_PHONE=96179049544

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -------------------------------------------------------------
# DATABASE — the SAME dedicated Loop DB the Loop POS (looplb.systempos.lt) uses.
# This is a NEW, separate database (not the main PRODPOS). Use the exact
# values from the Loop POS .env at:
#   domains/systempos.lt/public_html/looplb/.env
# Created in hPanel, e.g. u301998635_loop. Host is localhost on Hostinger.
# -------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u301998635_loop
DB_USERNAME=u301998635_loop
DB_PASSWORD=__SET_ON_SERVER_ONLY__

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@looplb.shop"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
