# =============================================================
# PRODUCTION .env for the STORE (looplb.shop on Hostinger)
# Path on server: domains/looplb.shop/laravel/.env
# Copy this to `.env` on the server and fill the DB_* values.
# =============================================================

APP_NAME="Loop lb"
APP_ENV=production
APP_KEY=base64:QGo08yGnfxalNogkb5zMNXfZQdx1oFT3ujgLc9y3aMM=
APP_DEBUG=false
APP_URL=https://looplb.shop

# Images live in the POS storage and are served from the POS domain.
# The POS must have run `php artisan storage:link` so /storage is public.
POS_ASSET_URL=https://systempos.lt/storage

WHATSAPP_PHONE=9613464695

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -------------------------------------------------------------
# DATABASE — MUST be the SAME database the POS (systempos.lt) uses.
# Copy these four values verbatim from the POS .env:
#   domains/systempos.lt/laravel/.env
# On Hostinger both sites share one MySQL host (localhost).
# -------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=__SAME_AS_POS__
DB_USERNAME=__SAME_AS_POS__
DB_PASSWORD=__SAME_AS_POS__

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@looplb.shop"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
